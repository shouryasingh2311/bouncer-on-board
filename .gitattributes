# Auto-detect text files and normalize line endings on checkout/commit
* text=auto

# Source code - force LF
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.sh text eol=lf

# Windows scripts - force CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.tar.gz binary
*.zip binary
*.whl binary
*.gguf binary
